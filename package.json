{
  "name": "saucedemo-test-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E Test Automation Framework for SauceDemo",
  "main": "index.js",
  "scripts": {
    "play:test": "npx playwright test",
    "play:debug": "npx playwright test --debug",
    "report": "npx playwright show-report",
    "test-s": "npx playwright test -g @sorting",
    "test-l": "npx playwright test -g @login",
    "test-c": "npx playwright test -g @cart"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunilkumar1701/SauceDemo-Test-Automation.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "pom",
    "e2e-testing"
  ],
  "author": "Sunil Kumar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sunilkumar1701/SauceDemo-Test-Automation/issues"
  },
  "homepage": "https://github.com/sunilkumar1701/SauceDemo-Test-Automation#readme",
  "devDependencies": {
    "@playwright/test": "^1.39.0",
    "@types/faker": "^6.6.9",
    "@types/jest": "^29.2.4",
    "faker": "^5.5.3",
    "jest": "29.3.1",
    "ts-jest": "29.0.3"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testTimeout": 120000
  },
  "dependencies": {
    "jest-cli": "^29.3.1"
  }
}
